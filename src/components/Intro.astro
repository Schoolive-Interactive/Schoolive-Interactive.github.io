---
import type { LocaleCopy } from '../lib/locale-types';

interface Props {
  copy: LocaleCopy;
}

const { copy } = Astro.props;
---

<section id="introduction" class="bg-white py-24 md:py-32">
  <div class="site-container">
    <div class="mx-auto max-w-4xl text-center">
      <span class="mb-4 inline-flex rounded-full bg-brand-light px-4 py-2 text-sm font-bold uppercase tracking-[0.2em] text-brand-deep">Schoolive</span>
      <h2 class="section-title text-slate-950">{copy.intro.title}</h2>
      <p class="mt-8 text-lg leading-8 text-slate-600 md:text-xl md:leading-9">{copy.intro.body}</p>
    </div>
  </div>
</section>
