---
import { localePath, locales } from '../lib/routes';
import type { Locale, LocaleCopy } from '../lib/locale-types';

interface Props {
  locale: Locale;
  copy: LocaleCopy;
}

const { locale, copy } = Astro.props;
---

<details class="group relative">
  <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full px-3 py-2 font-medium text-slate-700 transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand">
    <span class="i-fa6-solid-language" aria-hidden="true"></span>
    <span>{copy.nav.language}</span>
    <span class="i-fa6-solid-chevron-down text-xs transition group-open:rotate-180" aria-hidden="true"></span>
  </summary>
  <div class="absolute right-0 z-30 mt-3 min-w-44 overflow-hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl shadow-slate-900/15">
    {locales.map((targetLocale) => (
      <a
        class:list={[
          'block rounded-xl px-4 py-2 text-sm font-medium transition hover:bg-brand-light hover:text-brand-deep focus:outline-none focus:ring-2 focus:ring-brand',
          targetLocale === locale ? 'bg-brand-light text-brand-deep' : 'text-slate-700',
        ]}
        href={localePath(targetLocale)}
        aria-current={targetLocale === locale ? 'page' : undefined}
      >
        {copy.languageNames[targetLocale]}
      </a>
    ))}
  </div>
</details>
