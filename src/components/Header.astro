---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localePath, sectionPath } from '../lib/routes';
import type { Locale, LocaleCopy } from '../lib/locale-types';

interface Props {
  locale: Locale;
  copy: LocaleCopy;
}

const { locale, copy } = Astro.props;
const navItems = [
  { label: copy.nav.top, href: localePath(locale) },
  { label: copy.nav.introduction, href: sectionPath(locale, 'introduction') },
  { label: copy.nav.members, href: sectionPath(locale, 'members') },
];
---

<header class="sticky top-0 z-40 border-b border-white/70 bg-white/90 shadow-sm backdrop-blur-xl">
  <nav class="site-container flex min-h-18 items-center justify-between gap-4 py-3" aria-label="Primary navigation">
    <a class="flex items-center gap-3 rounded-full focus:outline-none focus:ring-2 focus:ring-brand" href={localePath(locale)}>
      <img src="/assets/images/brand/schoolive-logo.png" alt="Schoolive" class="h-12 w-12" />
      <span class="text-xl font-bold tracking-tight text-slate-950">Schoolive</span>
    </a>

    <div class="hidden items-center gap-2 md:flex">
      {navItems.map((item) => (
        <a class="rounded-full px-4 py-2 font-medium text-slate-700 transition hover:bg-slate-100 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-brand" href={item.href}>
          {item.label}
        </a>
      ))}
      <LanguageSwitcher locale={locale} copy={copy} />
    </div>

    <div class="md:hidden">
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-slate-200 px-3 py-2 font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand">
          <span class="i-fa6-solid-bars" aria-hidden="true"></span>
          <span>Menu</span>
        </summary>
        <div class="absolute right-0 mt-3 w-64 rounded-3xl border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-900/15">
          {navItems.map((item) => (
            <a class="block rounded-2xl px-4 py-3 font-medium text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand" href={item.href}>
              {item.label}
            </a>
          ))}
          <div class="mt-2 border-t border-slate-100 pt-2">
            <LanguageSwitcher locale={locale} copy={copy} />
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
