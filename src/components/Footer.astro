---
import social from '../data/social.json';
import type { LocaleCopy } from '../lib/locale-types';

interface Props {
  copy: LocaleCopy;
}

const { copy } = Astro.props;
---

<footer class="bg-slate-950 py-14 text-white">
  <div class="site-container grid gap-10 md:grid-cols-[1.2fr_1fr_1fr] md:items-start">
    <div>
      <a class="inline-flex items-center gap-3 rounded-full focus:outline-none focus:ring-2 focus:ring-brand" href="#top">
        <img src="/assets/images/brand/schoolive-logo.png" alt="Schoolive" class="h-16 w-16" />
        <span class="text-2xl font-extrabold tracking-tight">Schoolive</span>
      </a>
      <p class="mt-5 max-w-sm text-sm leading-6 text-slate-400">{copy.footer.copyright}</p>
    </div>

    <div>
      <h2 class="text-base font-bold">{copy.footer.followUs}</h2>
      <div class="mt-4 flex gap-3">
        <a
          class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-xl transition hover:bg-brand focus:outline-none focus:ring-2 focus:ring-brand"
          href={social.bilibili.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bilibili"
        >
          <span class="i-simple-icons-bilibili" aria-hidden="true"></span>
        </a>
        <a
          class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-xl transition hover:bg-brand focus:outline-none focus:ring-2 focus:ring-brand"
          href={social.email.url}
          aria-label={copy.footer.emailLabel}
        >
          <span class="i-fa6-solid-envelope" aria-hidden="true"></span>
        </a>
      </div>
    </div>

    <address class="not-italic">
      <h2 class="text-base font-bold">{copy.footer.companyName}</h2>
      <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-400">
        {copy.footer.addressLines.map((line) => <li>{line}</li>)}
      </ul>
    </address>
  </div>
</footer>
