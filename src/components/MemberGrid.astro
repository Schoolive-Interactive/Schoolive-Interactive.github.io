---
import members from '../data/members.json';
import { localizeTemplate } from '../lib/i18n';
import type { LocaleCopy, MemberProfile } from '../lib/locale-types';

interface Props {
  copy: LocaleCopy;
}

const { copy } = Astro.props;
const memberProfiles = members as MemberProfile[];
---

<section id="members" class="bg-gradient-to-b from-slate-50 to-brand-light/50 py-24 md:py-32">
  <div class="site-container">
    <h2 class="section-title text-slate-950">{copy.members.title}</h2>
    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {memberProfiles.map((member) => (
        <article class="member-card">
          <a
            class="group block focus:outline-none focus:ring-4 focus:ring-brand/50"
            href={member.bilibiliUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={localizeTemplate(copy.members.cardLabel, { name: member.name })}
          >
            <img src={member.image} alt={member.name} class="aspect-square w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
            <div class="flex items-center justify-between gap-3 p-5">
              <p class="font-bold text-slate-900">{member.name}</p>
              <span class="i-simple-icons-bilibili shrink-0 text-xl text-brand-deep" aria-hidden="true"></span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
